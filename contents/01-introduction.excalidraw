    },
    {
      "id": "o8HrjB0Cv7zuVsse9vX5t",
      "type": "text",
      "x": 1855.1030790376672,
      "y": 272.22426885792703,
      "width": 797.0593872070312,
      "height": 150,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aC",
      "roundness": null,
      "seed": 888003415,
      "version": 91,
      "versionNonce": 1258038423,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786910016580,
      "link": null,
      "locked": false,
      "text": "Grafana is primarily used in this course for visualizing application performance\nmetrics through dashboards that include charts and graphs. It connects to many\ndata sources, with a focus on Prometheus, allowing you to gather and display\ndata from various tools in one place. Additionally, Grafana supports alerting\nbased on custom rules and integrates AI features to help build smarter, more\nintuitive dashboards.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Grafana is primarily used in this course for visualizing application performance metrics through dashboards that include charts and graphs. It connects to many data sources, with a focus on Prometheus, allowing you to gather and display data from various tools in one place. Additionally, Grafana supports alerting based on custom rules and integrates AI features to help build smarter, more intuitive dashboards.",
      "autoResize": false,
      "lineHeight": 1.25
    },
