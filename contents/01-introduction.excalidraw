    {
      "id": "R0TAy4pfxdxfqSQ1doiB3",
      "type": "text",
      "x": 2713.278883003474,
      "y": 1361.8996874547306,
      "width": 704.739501953125,
      "height": 375,
      "angle": 0,
      "strokeColor": "#868e96",
